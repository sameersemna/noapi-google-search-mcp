# /etc/noapi-google-search-mcp.env
#
# Environment for mcp-google.service. The unit reads this file
# (EnvironmentFile=-/etc/noapi-google-search-mcp.env); it is marked optional with
# a leading "-", so a missing file starts the service with defaults and NO error.
# That is exactly how transcription silently ran on a local CPU model: the file
# did not exist, so no WHISPER_* variable was ever set.
#
# Install:
#   sudo install -m 0600 -o root -g root /dev/null /etc/noapi-google-search-mcp.env
#   sudo tee /etc/noapi-google-search-mcp.env >/dev/null < deploy/noapi-google-search-mcp.env
#   sudo systemctl daemon-reload && sudo systemctl restart mcp-google.service
#
# Keep secrets (WHISPER_REMOTE_API_KEY, IMAP/S3 credentials) here, never in the
# unit file — `systemctl show` would print them.

# ── Transcription: the GPU host (required, no local fallback) ─────────────
# whisper.cpp server on the Dell Pro Max GB10. No bearer token is used by that
# deployment, so nothing secret is needed here.
WHISPER_REMOTE_ENABLED=1
WHISPER_REMOTE_URL=http://promaxgb10-6116:8768
WHISPER_REMOTE_API_STYLE=whispercpp
# Must be 0: the old 1 MB threshold existed to keep short clips on a local
# model, which no longer exists, so anything under it would be skipped entirely.
WHISPER_REMOTE_MIN_FILE_BYTES=0
WHISPER_REMOTE_TIMEOUT_SEC=300
WHISPER_REMOTE_HEALTH_TIMEOUT_SEC=5
WHISPER_REMOTE_UNHEALTHY_COOLDOWN_SEC=60
WHISPER_REMOTE_PROBE_ON_STARTUP=1
