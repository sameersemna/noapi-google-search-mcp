# ─────────────────────────────────────────────────────────────────────────
# noapi-google-search-mcp — environment configuration
# ─────────────────────────────────────────────────────────────────────────
#
# This file is the canonical documentation of every env var the server
# reads. Copy it to /etc/noapi-google-search-mcp.env and edit there:
#
#   sudo cp .env.example /etc/noapi-google-search-mcp.env
#   sudo chown root:root /etc/noapi-google-search-mcp.env
#   sudo chmod 0600 /etc/noapi-google-search-mcp.env
#   sudoedit /etc/noapi-google-search-mcp.env
#
# systemd reads /etc/noapi-google-search-mcp.env (see mcp-google.service).
# start.sh sources the same file when present so dev matches prod.
#
# Every var below is OPTIONAL — the server runs fine with everything
# unset. The defaults shown here are the inline defaults in config.py.
# Uncomment a line to override it.
#
# Secrets (API keys, tokens, passwords) MUST stay in this file, NOT in
# the systemd unit file — otherwise they leak into `systemctl show`
# output and process listings.
# ─────────────────────────────────────────────────────────────────────────

# ── Display / manual intervention ────────────────────────────────────────
# Required for the "open a headful browser so I can solve the CAPTCHA"
# fallback. The systemd unit already sets these for production; you only
# need them here if you're running `start.sh` over SSH without `DISPLAY`.
# DISPLAY=:10.0
# XAUTHORITY=/home/sameer/.Xauthority

# ── Cookie validation ────────────────────────────────────────────────────
# Skip startup cookie validation. Useful for development. The systemd
# unit already sets this; uncomment here to override.
# SKIP_COOKIE_VALIDATION=1

# ── Health endpoint ──────────────────────────────────────────────────────
# Separate HTTP server on its own port for monitoring / k8s probes.
# The systemd unit already pins ENABLE_HEALTH_SERVER=1, HEALTH_HOST=0.0.0.0,
# HEALTH_PORT=11499.
# ENABLE_HEALTH_SERVER=1
# HEALTH_HOST=0.0.0.0
# HEALTH_PORT=11499
# Set to a non-empty value to require a bearer token on /health.
# HEALTH_AUTH_TOKEN=

# ── Manual intervention (headful CAPTCHA/login fallback) ─────────────────
# ENABLE_MANUAL_INTERVENTION=1
# MANUAL_INTERVENTION_TIMEOUT_SEC=300
# MANUAL_INTERVENTION_POLL_SEC=3.0

# ── yt-dlp / YouTube ─────────────────────────────────────────────────────
# YTDLP_RETRIES=3
# YTDLP_SOCKET_TIMEOUT=30
# YTDLP_PROXY=
# YTDLP_SECTION_DOWNLOAD=1
# YTDLP_PREFER_SUBTITLES=1
# YTDLP_ALLOW_AUTO_SUBTITLES=1
# YTDLP_YOUTUBE_CLIENTS=web_embedded,mweb

# ── Anti-detect (v0.3.4+) ────────────────────────────────────────────────
# ANTIDETECT_LEVEL=medium
# ANTIDETECT_SEARCH_VIA_TYPING=1
# ANTIDETECT_WARMUP_ON_FIRST_REQUEST=1
# ANTIDETECT_TAB_FOCUS_EVENTS=1
# ANTIDETECT_CLIENT_HINTS=1
# ANTIDETECT_RANDOMIZE_FINGERPRINT=1
# ANTIDETECT_VISIT_HOMEPAGE_FIRST=1
# ANTIDETECT_WARMUP_QUERIES=weather today,news today,time now,calculator,translate hello

# ── Human-like behavior ──────────────────────────────────────────────────
# HUMAN_BEHAVIOR_LEVEL=medium
# HUMAN_BEHAVIOR_DISABLE_JITTER=

# ── Search-result redirect resolution ────────────────────────────────────
# REDIRECT_RESOLVE_TIMEOUT=8
# REDIRECT_RESOLVE_CACHE_SIZE=512

# ─────────────────────────────────────────────────────────────────────────
# Remote Whisper delegation (v0.3.6+)
# ─────────────────────────────────────────────────────────────────────────
# Off by default — when WHISPER_REMOTE_ENABLED=0, every transcription
# runs locally on CPU via faster-whisper, exactly as it always has.
#
# When enabled, audio files larger than WHISPER_REMOTE_MIN_FILE_BYTES
# are uploaded to a remote Whisper server. Smaller files stay local
# (the round-trip latency isn't worth it for short clips).
#
# Two API styles are supported via WHISPER_REMOTE_API_STYLE:
#
#   "openai"     — POST /v1/audio/transcriptions
#                  Compatible servers: `speaches` (formerly
#                  fedirz/faster-whisper-server), OpenAI's own API,
#                  octopus2023/insanely-fast-whisper-server, etc.
#
#   "whispercpp" — POST /inference
#                  Compatible servers: whisper.cpp's `server` example
#                  (https://github.com/ggml-org/whisper.cpp). No
#                  per-request model field (the server has the model
#                  loaded internally via /load).
#
# Recommended hardware: deploy either server on a CUDA-capable GPU
# host. Dell Pro Max GB10 (Grace Blackwell, unified memory) is ideal
# — run `large-v3` or `distil-large-v3` for the best accuracy. The
# local machine keeps running `tiny` as automatic fallback.

# 0 = local-only (default), 1 = delegate to remote when eligible
WHISPER_REMOTE_ENABLED=0

# Base URL of the remote server, no trailing slash. Example for the
# Dell Pro Max GB10 box on the LAN:
#   WHISPER_REMOTE_URL=http://promaxgb10-6116:8768
WHISPER_REMOTE_URL=

# Optional bearer token. Empty = no Authorization header sent. Keep
# this OUT of the systemd unit file — only put it here.
WHISPER_REMOTE_API_KEY=

# Model to request from the remote server. Local invocations are always
# `tiny` by default; the whole point of the remote is to run something
# heavier on the GPU. Ignored by WHISPER_REMOTE_API_STYLE=whispercpp —
# the whisper.cpp server loads its model internally via /load.
WHISPER_REMOTE_MODEL=large-v3

# Wire protocol: "openai" (default) or "whispercpp".
#   openai     — POST /v1/audio/transcriptions (speaches, fedirz, etc.)
#   whispercpp — POST /inference (whisper.cpp's server example)
WHISPER_REMOTE_API_STYLE=openai

# Per-request timeout (seconds). Transcription of long audio on a cold
# model can take a minute.
WHISPER_REMOTE_TIMEOUT_SEC=300

# Health-probe timeout (separate, shorter). Used by the in-process
# probe and by /health.
WHISPER_REMOTE_HEALTH_TIMEOUT_SEC=5

# Minimum audio file size in bytes before the remote path is considered.
# A 30 s mp3 at 128 kbps is ~480 KB, so 1 MB keeps sub-minute clips local.
WHISPER_REMOTE_MIN_FILE_BYTES=1048576

# When the remote is detected as down, skip it for this many seconds
# before re-probing. Avoids hammering a crashed / unreachable server.
WHISPER_REMOTE_UNHEALTHY_COOLDOWN_SEC=60

# Whether to run a single probe against the remote URL at startup.
# Cheap (one short HTTP GET) and makes /health immediately informative.
WHISPER_REMOTE_PROBE_ON_STARTUP=1

# ─────────────────────────────────────────────────────────────────────────
# Bootstrap checklist (whisper.cpp server)
# ─────────────────────────────────────────────────────────────────────────
#
# 1.  On the GPU host (Dell Pro Max GB10, or any CUDA box), clone
#     whisper.cpp and build the server example:
#
#         git clone https://github.com/ggml-org/whisper.cpp
#         cd whisper.cpp
#         cmake -B build -DWHISPER_CUDA=1
#         cmake --build build --config Release -j
#
# 2.  Download a model (large-v3 recommended for the GB10's unified memory):
#
#         ./build/bin/whisper-download-ggml-model large-v3
#
# 3.  Launch the server. Important flags for our integration:
#         -m <model>     model file
#         --host 0.0.0.0 bind on all interfaces
#         --port 8768    match the value in WHISPER_REMOTE_URL
#         -ml 1          enable multilingual auto-detection
#
#         ./build/bin/whisper-server \
#             -m models/ggml-large-v3.bin \
#             --host 0.0.0.0 \
#             --port 8768 \
#             -ml 1
#
# 4.  Verify with a direct curl against /health:
#
#         curl http://promaxgb10-6116:8768/health
#         # {"status":"ok"}
#
# 5.  Test a real transcription request:
#
#         curl -X POST http://promaxgb10-6116:8768/inference \
#             -F file=@/path/to/clip.wav \
#             -F response_format=verbose_json \
#             -F temperature=0.0 \
#             -F temperature_inc=0.2
#
#     You should see segments[] with start/end/text fields.
#
# 6.  Set WHISPER_REMOTE_ENABLED=1, WHISPER_REMOTE_API_STYLE=whispercpp,
#     and WHISPER_REMOTE_URL=http://promaxgb10-6116:8768 above, then:
#
#         sudo systemctl restart mcp-google.service
#         curl -s http://localhost:11499/health | jq .dependencies.whisper_remote
#
#     You should see ok: true, api_style: "whispercpp", and a probe
#     latency in milliseconds.
#
# 7.  Trigger a transcription:
#
#         # From LM Studio / Claude Desktop:
#         #   "Transcribe this video: https://youtube.com/watch?v=..."
#
#     Watch the service log for "Remote Whisper OK: N segments, ...".
#
# If you instead want to use an OpenAI-compatible server like
# `speaches` (https://github.com/speaches-ai/speaches), set
# WHISPER_REMOTE_API_STYLE=openai and follow that project's README
# for setup — everything else (URL, API key, model name, env
# variables) is identical.
#
# ─────────────────────────────────────────────────────────────────────────
