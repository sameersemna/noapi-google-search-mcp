[Unit]
Description=MCP Google HTTP Proxy Bridge
After=network.target

[Service]
Type=simple
User=sameer
WorkingDirectory=/home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp
Environment=PYTHONUNBUFFERED=1
Environment=SKIP_COOKIE_VALIDATION=1
# ── Graphical display for manual-intervention (headful) browser ──
# The machine runs an X session on :10.0 owned by sameer (xrdp). A systemd
# service does NOT inherit DISPLAY/XAUTHORITY, so without these the headful
# "solve the CAPTCHA in a visible window" fallback can't open and silently
# falls back to DuckDuckGo. Point the service at the existing display so
# manual intervention works. (Verify with: DISPLAY=:10.0 xdpyinfo)
Environment=DISPLAY=:10.0
Environment=XAUTHORITY=/home/sameer/.Xauthority
# Health server: separate HTTP endpoint for monitoring/k8s probes.
# Listens on 0.0.0.0:11499. Disable with ENABLE_HEALTH_SERVER=0.
Environment=ENABLE_HEALTH_SERVER=1
Environment=HEALTH_HOST=0.0.0.0
Environment=HEALTH_PORT=11499
# Set HEALTH_AUTH_TOKEN to require a bearer token (empty = no auth).
# Environment=HEALTH_AUTH_TOKEN=
Environment=PATH=/home/sameer/.n/n/versions/node/26.3.0/bin:/home/sameer/anaconda3/envs/mcp-google/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Pre-start cleanup: kill any lingering process on the health port (11499)
# and the MCP proxy port (11403) to prevent "address already in use" errors.
ExecStartPre=-/bin/bash -c 'fuser -k 11499/tcp 2>/dev/null || true'
ExecStartPre=-/bin/bash -c 'fuser -k 11403/tcp 2>/dev/null || true'
# Clean up stale PID file from previous runs.
ExecStartPre=-/bin/bash -c 'rm -f /home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp/service.pid'

StandardOutput=append:/home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp/service.log
StandardError=inherit

# ExecStart=/home/sameer/.n/n/versions/node/26.3.0/bin/node /home/sameer/.n/n/versions/node/26.3.0/bin/npx -y mcp-proxy --port 11403 --transport streamable-http -- /home/sameer/anaconda3/envs/mcp-google/bin/python -i -m google_search_mcp
# Remove the -i flag from the systemd unit so the process exits on crash (allowing systemd to restart it)
ExecStart=/home/sameer/.n/n/versions/node/26.3.0/bin/node /home/sameer/.n/n/versions/node/26.3.0/bin/npx -y mcp-proxy --port 11403 --transport streamable-http -- /home/sameer/anaconda3/envs/mcp-google/bin/python -m google_search_mcp

# Ensure the old process is fully terminated before restart.
# KillMode=mixed: SIGTERM to main process, SIGKILL to children.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=on-failure
RestartSec=10
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
