[Unit]
Description=MCP Google HTTP Proxy Bridge
After=network.target

[Service]
Type=simple
User=sameer
WorkingDirectory=/home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp

# ── Environment ────────────────────────────────────────────────────────
# Most env vars live in /etc/noapi-google-search-mcp.env (mode 0600). That
# keeps secrets (WHISPER_REMOTE_API_KEY, etc.) out of the unit file and out
# of `systemctl show mcp-google.service` output. See .env.example in the
# project root for the full schema.
#
# If the file is missing, the unit still starts — systemd silently ignores
# an unreadable EnvironmentFile. To bootstrap one:
#
#   sudo cp .env.example /etc/noapi-google-search-mcp.env
#   sudo chown root:root /etc/noapi-google-search-mcp.env
#   sudo chmod 0600 /etc/noapi-google-search-mcp.env
#   sudoedit /etc/noapi-google-search-mcp.env
EnvironmentFile=-/etc/noapi-google-search-mcp.env

# Hard-coded baseline (also overridden by EnvironmentFile if present).
Environment=PYTHONUNBUFFERED=1
Environment=SKIP_COOKIE_VALIDATION=1
# ── Graphical display for manual-intervention (headful) browser ──
# The machine runs an X session on :10.0 owned by sameer (xrdp). A systemd
# service does NOT inherit DISPLAY/XAUTHORITY, so without these the headful
# "solve the CAPTCHA in a visible window" fallback can't open and silently
# falls back to DuckDuckGo. Point the service at the existing display so
# manual intervention works. (Verify with: DISPLAY=:10.0 xdpyinfo)
Environment=DISPLAY=:10.0
Environment=XAUTHORITY=/home/sameer/.Xauthority
# Health server: separate HTTP endpoint for monitoring/k8s probes.
# Listens on 0.0.0.0:11499. Disable with ENABLE_HEALTH_SERVER=0.
Environment=ENABLE_HEALTH_SERVER=1
Environment=HEALTH_HOST=0.0.0.0
Environment=HEALTH_PORT=11499
# Set HEALTH_AUTH_TOKEN to require a bearer token (empty = no auth).
# Environment=HEALTH_AUTH_TOKEN=

# ── MCP HTTP transport (served natively; no mcp-proxy) ──
# Port 11403 is now bound by this process itself. Stateful streamable HTTP is
# the default: the client gets an Mcp-Session-Id on initialize and echoes it
# back. Set NOAPI_MCP_HTTP_STATELESS=1 for a client that POSTs once per tool
# call — stateless mode keeps no session registry at all, so a dropped
# connection can never leave a dangling session behind.
Environment=NOAPI_MCP_HTTP_STATELESS=0
# Serve the deprecated GET /sse + POST /messages/ transport alongside /mcp for
# one release so existing SSE clients keep working. Set to 0 to serve /mcp only.
Environment=NOAPI_MCP_HTTP_ENABLE_LEGACY_SSE=1
# Host/Origin validation for DNS-rebinding protection. OFF by default: the SDK
# auto-enables it for loopback binds with a loopback-only allow-list, which
# answers 421 to any request addressed to a LAN name such as `latitude:11403`.
# Turn it on (and list NOAPI_MCP_HTTP_ALLOWED_HOSTS) if this port is ever exposed
# beyond the LAN.
Environment=NOAPI_MCP_HTTP_DNS_REBINDING_PROTECTION=0

Environment=PATH=/home/sameer/.n/n/versions/node/26.3.0/bin:/home/sameer/anaconda3/envs/mcp-google/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Pre-start cleanup: kill any lingering process on the health port (11499)
# and the MCP port (11403) to prevent "address already in use" errors.
ExecStartPre=-/bin/bash -c 'fuser -k 11499/tcp 2>/dev/null || true'
ExecStartPre=-/bin/bash -c 'fuser -k 11403/tcp 2>/dev/null || true'
# Clean up stale PID file from previous runs.
ExecStartPre=-/bin/bash -c 'rm -f /home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp/service.pid'

StandardOutput=append:/home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp/service.log
StandardError=inherit

# The MCP server binds 11403 itself and speaks streamable HTTP (/mcp) plus the
# legacy SSE transport (/sse + /messages/). This replaces the previous
# `npx mcp-proxy --port 11403 --transport streamable-http -- python -m ...`
# chain: mcp-proxy has no --transport option, so that flag was silently ignored,
# and it added an unpinned npx download plus a second process to every restart.
# The app must NOT be run with `-i`: it needs to exit on crash so systemd's
# Restart=on-failure can restart it.
ExecStart=/home/sameer/anaconda3/envs/mcp-google/bin/python -m google_search_mcp --transport streamable-http --host 0.0.0.0 --port 11403

# Ensure the old process is fully terminated before restart.
# KillMode=mixed: SIGTERM to main process, SIGKILL to children.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=on-failure
RestartSec=10
StartLimitBurst=3

# ── Memory guard ───────────────────────────────────────────────────────
# This service once grew to 6.9 GB because native engines (Whisper, RapidOCR,
# ONNX Runtime) were rebuilt per call and their arenas never released. The leak
# is fixed in utils/singletons.py, but the failure mode is worth containing:
# the kernel OOM-killer picked `code` before it picked the server, so a server
# leak crashed the editor twice.
#
# MemoryMax makes systemd stop THIS unit at the ceiling instead of letting it
# push the machine into global OOM. MemoryHigh adds back-pressure first
# (reclaim) so normal load is unaffected. OOMScoreAdjust biases the kernel to
# kill the server rather than the desktop if global OOM happens anyway.
# Raise MemoryMax if you routinely transcribe long videos: a Whisper
# medium/large model alone is ~1.5-3 GB.
MemoryHigh=3G
MemoryMax=6G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
