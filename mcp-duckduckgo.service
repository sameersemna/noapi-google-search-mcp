[Unit]
Description=MCP DuckDuckGo HTTP Proxy Bridge
After=network.target

[Service]
Type=simple
User=sameer
WorkingDirectory=/home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp
Environment=PYTHONUNBUFFERED=1
Environment=DDG_DISABLE_DNS_REBINDING_PROTECTION=1
Environment=PATH=/home/sameer/.n/n/versions/node/26.3.0/bin:/home/sameer/anaconda3/envs/mcp-google/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

StandardOutput=append:/home/sameer/Shared/Sync/Private/Apps/services/mcp/noapi-google-search-mcp/mcp-duckduckgo.log
StandardError=inherit

ExecStart=/home/sameer/.local/bin/uvx duckduckgo-mcp-server --transport streamable-http --host 0.0.0.0 --port 11404 --disable-dns-rebinding-protection

Restart=on-failure
RestartSec=10
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
